# 저장소 작업 지침은 코드와 함께 관리한다.
!AGENTS.md

# Android Studio / IntelliJ 로컬 상태
*.iml
/.idea/

# Gradle 및 Android 빌드 산출물
/.gradle/
/.kotlin/
/**/build/
/captures/
/.externalNativeBuild/
/.cxx/
/local.properties
/gradle/gradle-daemon-jvm.properties
*.class
*.jar
*.log
.env*
/out/
/tmp/

# OS 메타데이터
.DS_Store
Thumbs.db

# Codex·Spec Kit 로컬 도구 런타임
/.agents/
# constitution은 팀 규약이므로 예외로 추적한다.
/.specify/*
!/.specify/memory/
/.specify/memory/*
!/.specify/memory/constitution.md

# Claude Code 로컬 상태 (스킬·공유 설정은 커밋한다)
/.claude/settings.local.json
/.claude/.credentials.json
/.claude/plugins/
/.claude/worktrees/

# 서명 자료
*.jks
*.keystore
